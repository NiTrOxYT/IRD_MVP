# Aura Resort & Spa · Modular Hospitality Platform Environment Configuration

# ─────────────────────────────────────────────────────────
# Backend Configuration (Standalone API Server)
# ─────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_ird_pass
POSTGRES_DB=ird_resort_db
DATABASE_URL=postgresql://postgres:postgres_secure_ird_pass@localhost:5432/ird_resort_db

JWT_SECRET=aura_resort_ird_prod_secret_84920491
BACKEND_PORT=5001
NODE_ENV=development

# Comma-separated frontend origins allowed for CORS when frontend and backend are hosted separately.
# Leave empty in local/Docker gateway mode to allow same-origin & local network dev access.
CORS_ORIGINS=

# ─────────────────────────────────────────────────────────
# Frontend Configuration (Standalone React/Vite App)
# ─────────────────────────────────────────────────────────
PORT=3000
# Point to an external backend URL when deploying frontend separately from backend:
# VITE_API_URL=https://api.example.com/api
# VITE_SOCKET_URL=https://api.example.com
# VITE_DEV_PROXY_TARGET=http://localhost:5001

# Optional Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=replace_with_ird_tunnel_token
