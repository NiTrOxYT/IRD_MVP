# Aura Resort & Spa · In-Room Dining Environment Configuration

# Database Configuration (Docker Compose & Local PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_ird_pass
POSTGRES_DB=ird_resort_db
DATABASE_URL=postgresql://postgres:postgres_secure_ird_pass@localhost:5432/ird_resort_db

# Security & Secrets
JWT_SECRET=aura_resort_ird_prod_secret_84920491

# Ports
PORT=3000
BACKEND_PORT=5001
NODE_ENV=development

# Optional: set this only after creating the dedicated IRD tunnel in Cloudflare.
# Keep the real token private in .env; never commit or share it.
CLOUDFLARE_TUNNEL_TOKEN=replace_with_ird_tunnel_token
